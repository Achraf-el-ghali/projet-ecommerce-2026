{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-badge-fill text-primary" style="font-size: 4rem;"></i>
                    <h2 class="fw-bold mt-2 text-dark">Mon Profil</h2>
                    <p class="text-secondary">Informations sur votre compte étudiant</p>
                </div>

                <div class="list-group list-group-flush mb-4">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Adresse Email</h6>
                            <small class="text-muted">Utilisée pour vous connecter</small>
                        </div>
                        <span class="fs-6 text-primary fw-semibold">{{ user.email }}</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Identifiant unique (ID)</h6>
                            <small class="text-muted">Référence de votre compte</small>
                        </div>
                        <span class="badge bg-light text-dark border px-3 py-2">#{{ user.id }}</span>
                    </div>

                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Rôles / Permissions</h6>
                            <small class="text-muted">Niveau d'accès sur la plateforme</small>
                        </div>
                        <div>
                            {% for role in user.roles %}
                                <span class="badge bg-info text-white me-1">{{ role }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a href="{{ path('app_catalog_all') }}" class="btn btn-primary">
                        <i class="bi bi-book"></i> Accéder au catalogue de cours
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                        <i class="bi bi-box-arrow-right"></i> Se déconnecter
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

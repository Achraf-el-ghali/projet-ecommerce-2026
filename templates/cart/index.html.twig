{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2 text-dark"><i class="bi bi-cart3"></i> Mon Panier</h1>
        </div>
    </div>

    {% if items is not empty %}
        <div class="row">
            <div class="col-lg-8 col-12 mb-4">
                <div class="card shadow-sm border">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Formation</th>
                                    <th scope="col">Catégorie</th>
                                    <th scope="col" class="text-end">Tarif</th>
                                    <th scope="col" class="text-center">Quantité</th>
                                    <th scope="col" class="text-end">Total</th>
                                    <th scope="col" class="text-center pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                    <tr>
                                        <td class="ps-4">
                                            <a href="{{ path('app_catalog_view', { slug: item.product.slug }) }}" class="fw-bold text-decoration-none text-dark">
                                                {{ item.product.name }}
                                            </a>
                                            <br>
                                            <small class="text-muted">Par {{ item.product.author }}</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ item.product.category.name }}</span>
                                        </td>
                                        <td class="text-end">
                                            {{ item.product.price | number_format(2, ',', ' ') }} DH
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-3 py-2 fs-6">{{ item.quantity }}</span>
                                        </td>
                                        <td class="text-end fw-bold text-primary">
                                            {{ (item.product.price * item.quantity) | number_format(2, ',', ' ') }} DH
                                        </td>
                                        <td class="text-center pe-4">
                                            <a href="{{ path('app_cart_remove', { id: item.product.id }) }}" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Retirer
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="card shadow-sm border mb-4">
                    <div class="card-body">
                        <h4 class="card-title text-dark border-bottom pb-2 mb-3">Récapitulatif</h4>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span>Total HT :</span>
                            <span class="fw-bold">{{ total | number_format(2, ',', ' ') }} DH</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-top pt-3 fs-4 text-success fw-bold">
                            <span>Total TTC :</span>
                            <span>{{ total | number_format(2, ',', ' ') }} DH</span>
                        </div>
                        <hr>
                        <div class="d-grid gap-2">
                            <a href="#" class="btn btn-success btn-lg">
                                <i class="bi bi-credit-card-2-front"></i> Passer la commande
                            </a>
                            <a href="{{ path('app_cart_clear') }}" class="btn btn-outline-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir vider votre panier ?');">
                                <i class="bi bi-x-circle"></i> Vider le panier
                            </a>
                        </div>
                    </div>
                </div>

                <div class="d-grid">
                    <a href="{{ path('app_catalog_all') }}" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Continuer mes achats
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="p-5 mb-4 bg-light rounded-3 border text-center">
            <div class="container-fluid py-5">
                <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                <h2 class="mt-3 text-dark">Votre panier est vide</h2>
                <p class="col-md-8 mx-auto fs-5 text-secondary">
                    Vous n'avez ajouté aucune formation à votre panier pour le moment. Explorez notre catalogue pour commencer votre apprentissage.
                </p>
                <a href="{{ path('app_catalog_all') }}" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-book"></i> Découvrir le Catalogue
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

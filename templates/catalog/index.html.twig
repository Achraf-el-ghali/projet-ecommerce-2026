{% extends 'base.html.twig' %}

{% block title %}Catalogue des cours{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 border">
        <div class="container-fluid py-5">
            <h1 class="display-5 fw-bold text-primary">Catalogue des formations</h1>
            <p class="col-md-8 fs-4 text-secondary">
                Explorez nos formations en ligne, conçues par des experts pour vous aider à progresser.
            </p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for course in courses %}
            <div class="col">
                <div class="card h-100 shadow-sm border">
                    <div class="card-body">
                        <div class="badge bg-primary mb-2">{{ course.category.name }}</div>
                        <h5 class="card-title text-dark">{{ course.name }}</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            Par {{ course.author }}
                        </h6>
                        <p class="card-text text-secondary">{{ course.synopsis }}</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center bg-white border-top-0 pb-3">
                        <span class="fw-bold fs-5 text-success">
                            {{ course.price | number_format(2, ',', ' ') }} DH
                        </span>
                        <div>
                            <a href="{{ path('app_catalog_view', { slug: course.slug }) }}" class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_cart_add', { id: course.id }) }}" class="btn btn-success btn-sm">
                                <i class="bi bi-cart-plus"></i> Prendre
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">Aucune formation trouvée.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

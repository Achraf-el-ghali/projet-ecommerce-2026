{% extends 'base.html.twig' %}

{% block title %}{{ course.name }}{% endblock %}

{% block body %}
<div class="p-5 mb-4 mt-4 bg-light rounded-3 border">
    <div class="container-fluid py-5">
        <div class="badge bg-primary mb-3">{{ course.category.name }}</div>
        <h1 class="display-5 fw-bold text-primary">{{ course.name }}</h1>
        <p class="col-md-8 fs-4 text-secondary">{{ course.synopsis }}</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-9 col-md-8 col-12">
        <div class="card mb-4 shadow-sm border">
            <div class="card-body">
                <h3 class="card-title text-dark mb-3">{{ course.name | upper }}</h3>
                <h6 class="card-subtitle mb-3 text-muted">
                    Formateur : <strong>{{ course.author }}</strong>
                </h6>
                <p class="card-text fs-4 text-success fw-bold">
                    Tarif : {{ course.price | number_format(2, ',', ' ') }} DH
                </p>
                <hr>
                <h5 class="mt-4 mb-3 text-dark">Description détaillée</h5>
                <p class="card-text text-secondary" style="line-height: 1.6;">
                    {{ course.description }}
                </p>
                <div class="mt-4">
                    <a href="{{ path('app_cart_add', { id: course.id }) }}" class="btn btn-primary btn-lg px-4 me-2">
                        <i class="bi bi-cart-plus-fill"></i> Ajouter au panier
                    </a>
                    <a href="{{ path('app_catalog_all') }}" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-arrow-left"></i> Retour au catalogue
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-4 col-12">
        <div class="card shadow-sm border p-3">
            <h5 class="mb-3 text-primary"><i class="bi bi-compass"></i> Suggestions</h5>
            {{ render(controller('App\\Controller\\CatalogController::similarCourses', { limit: 3 })) }}
        </div>
    </div>
</div>
{% endblock %}

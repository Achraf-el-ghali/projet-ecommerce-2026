<div class="list-group">
    {% for course in courses %}
        <a href="{{ path('app_catalog_view', { slug: course.slug }) }}"
           class="list-group-item list-group-item-action shadow-sm border mb-2 rounded">
            <h6 class="mb-1 text-dark">{{ course.name }}</h6>
            <small class="text-secondary">{{ course.category.name }} — {{ course.price | number_format(2, ',', ' ') }} DH</small>
        </a>
    {% endfor %}
</div>
